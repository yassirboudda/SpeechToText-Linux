{
  "manifest_version": 3,
  "name": "SpeechToText",
  "version": "1.0.2",
  "description": "Voxtral speech-to-text for Chrome. Record up to 1:10, transcribe with Mistral AI, copy or type at cursor.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://api.mistral.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SpeechToText — Voxtral",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
